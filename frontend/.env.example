# Скопируйте в .env.local. Этот файл не содержит ключей.
SUPPORT_PORT=4180
# Сначала выберите Free Plan в Groq. Приложение не может определить тариф вашего ключа.
AI_ENABLED=false
AI_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
# Включать Telegram только после отдельной проверки бота.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BUSINESS_OWNER_ID=
# На первом тесте обязательно перечислите разрешённые chat_id через запятую.
TELEGRAM_ALLOWED_CHAT_IDS=
# Локальный прокси до core: браузеру не нужны CORS и адрес внутренней Docker-сети.
CORE_API_URL=http://127.0.0.1:30010
SUPPORT_HOST=127.0.0.1
