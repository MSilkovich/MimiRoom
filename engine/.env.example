# --- Meta ---
PROJECT_NAME="MimiRoom/ai-engine"
VERSION="0.0.1"

# --- Service ---
AI_ENGINE_PORT=30020

# --- Logging ---
LOG_LEVEL="DEBUG"
LOG_CONSOLE=true
LOG_FILE=false
LOG_FILE_PATH="/logs/ai-engine.log"
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5

# --- Backend (core service) ---
BACKEND_BASE_URL=http://core:30010
BACKEND_TIMEOUT_SEC=15
BACKEND_SECRET="S21svbORy6fWIyzDW2oaYPhdRvigsQ8B"

# --- LLM ---
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b
LLM_API_KEY=ollama
LLM_BASE_URL=http://192.168.1.185:11434/v1
LLM_TIMEOUT_SEC=60
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=1500
LLM_DEBUG_RAW=false

# --- Redis ---
REDIS_HOST=192.168.1.184
REDIS_PORT=6379
REDIS_PASSWORD=changeme
REDIS_DB=0

# --- Redis streams ---
REDIS_STREAM_NAME=bot:tasks
REDIS_GROUP_NAME=bot-engine
REDIS_RESPONSE_STREAM_NAME=bot:responses
REDIS_RESPONSE_MAXLEN=1000
# Должно быть больше REDIS_BLOCK_MS (иначе блокирующий XREADGROUP -> Timeout reading).
REDIS_SOCKET_TIMEOUT_SEC=15
REDIS_HEALTH_CHECK_INTERVAL_SEC=30

# --- Dialog memory ---
DIALOG_TTL_SEC=900

# --- Catalog / context ---
# Как часто пересобирать каталог услуг/мастеров (секунды).
CATALOG_TTL_SEC=1800
# Сколько последних сообщений истории отдавать модели.
MAX_HISTORY_MESSAGES=20

# --- Healthcheck ---
HEALTHCHECK_INTERVAL_SEC=30
HEALTHCHECK_TIMEOUT_SEC=3
HEALTHCHECK_BACKEND_ENABLED=true
HEALTHCHECK_LLM_ENABLED=false