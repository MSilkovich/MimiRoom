# --- Meta ---
PROJECT_NAME="MimiRoom/tg-bot"
VERSION="0.0.1"

# --- Bot ---
DEV=true
TEST_SERVER=false
DEVELOPER_ID=0
WEBHOOKS=false
BOT_TOKEN="CHANGE_ME"
BOT_USERNAME=""
WEBHOOK_URL=""
WEBHOOK_SECRET_TOKEN=""

# --- Logging ---
LOG_LEVEL="INFO"
LOG_CONSOLE=true
LOG_FILE=false
LOG_FILE_PATH="/logs/tg.log"
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5

# --- Core (backend) ---
CORE_BASE_URL=http://core:30010
CORE_TIMEOUT_SEC=15
CORE_SERVICE_SECRET="S21svbORy6fWIyzDW2oaYPhdRvigsQ8B"
CORE_PROVIDER=telegram
CORE_LINK_PATH=/api/v0.0.1/users/link

# --- Redis ---
REDIS_HOST=192.168.1.184
REDIS_PORT=6379
REDIS_PASSWORD=changeme
REDIS_DB=0

# --- Redis streams (должны совпадать с engine) ---
REDIS_TASK_STREAM_NAME=bot:tasks
REDIS_RESPONSE_STREAM_NAME=bot:responses
REDIS_RESPONSE_GROUP_NAME=tg-bot
REDIS_RESPONSE_CONSUMER_NAME=tg-bot-1
REDIS_READ_COUNT=10
REDIS_BLOCK_MS=5000

# --- Link cache (TTL диалога = 30 минут) ---
LINK_CACHE_KEY_PREFIX=tg:link
LINK_CACHE_TTL_SEC=1800
LINK_NEGATIVE_CACHE_TTL_SEC=30
